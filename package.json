{
  "name": "istiqamah",
  "version": "1.2.1",
  "description": "Istiqamah - Consistency in every day",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "browser": "start index.html",
    "build": "electron-builder --win",
    "dist": "electron-builder --win nsis portable",
    "release": "node scripts/publish-release.js",
    "generate-icons": "electron scripts/generate-icons.js"
  },
  "keywords": [
    "habit-tracker",
    "prayer-tracker",
    "istiqamah"
  ],
  "author": "Istiqamah",
  "license": "ISC",
  "build": {
    "appId": "com.istiqamah.app",
    "productName": "Istiqamah",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MusaMalik-1",
        "repo": "istiqamah"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "supabase-client.js",
      "index.html",
      "styles.css",
      "build/icon.ico",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Istiqamah"
    }
  },
  "devDependencies": {
    "electron": "^40.8.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "electron-updater": "^6.8.11",
    "lucide-static": "^1.61.0"
  }
}
